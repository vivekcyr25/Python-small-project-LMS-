VITE_API_URL=http://localhost:8000/api/v1
VITE_SYNCFUSION_LICENSE=your-syncfusion-license-key

# true = mock Google/Phone login (no Firebase project). false = real Firebase.
VITE_FIREBASE_USE_MOCK=true

# From Firebase Console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

